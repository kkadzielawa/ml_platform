# syntax=docker/dockerfile:1.7
FROM docker.io/library/python:3.12-slim@sha256:2c941e860699f878900b0edc2403613c234d4b32eda3cc9fa7036991a2a63c4a

ARG APP_HOME=/opt/ml-platform/build-fixture

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080

RUN --mount=type=secret,id=fixture_build_secret,required=false \
    set -eu; \
    if [ -f /run/secrets/fixture_build_secret ]; then \
      test -s /run/secrets/fixture_build_secret; \
    fi; \
    useradd --uid 10001 --create-home --home-dir /home/appuser --shell /usr/sbin/nologin appuser; \
    mkdir -p "${APP_HOME}"; \
    chown -R appuser:appuser "${APP_HOME}" /home/appuser

WORKDIR ${APP_HOME}
COPY --chown=appuser:appuser examples/build_fixture/app.py ./app.py

USER 10001:10001
EXPOSE 8080

CMD ["python", "app.py"]
