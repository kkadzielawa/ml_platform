{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/ml-platform-study/contracts/license-record.schema.json",
  "title": "License Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "name",
    "version",
    "source_url",
    "license",
    "review"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.0\\.0$"
    },
    "record_type": {
      "type": "string",
      "enum": ["software-package", "model-weights", "dataset", "generated-adapter"]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "expression", "classification"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["spdx", "custom", "unknown"]
        },
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "type": "string",
          "enum": ["osi-open-source", "open-content", "source-available", "restricted", "unknown"]
        },
        "osi_approved": {
          "type": ["boolean", "null"]
        },
        "attribution_required": {
          "type": "boolean"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "decision_by", "decision_date", "notes"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["accepted", "review-required", "rejected", "unknown"]
        },
        "decision_by": {
          "type": ["string", "null"]
        },
        "decision_date": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture", "base_model"],
      "properties": {
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "base_model": {
          "type": ["string", "null"]
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contains_personal_data", "attribution_text"],
      "properties": {
        "contains_personal_data": {
          "type": "boolean"
        },
        "attribution_text": {
          "type": ["string", "null"]
        }
      }
    },
    "generated_adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_model", "training_datasets", "generated_by_run_id", "inherited_obligations"],
      "properties": {
        "base_model": {
          "type": "string",
          "minLength": 1
        },
        "training_datasets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "generated_by_run_id": {
          "type": "string",
          "pattern": "^run-\\d{8}t\\d{6}z-[0-9a-f]{8}$"
        },
        "inherited_obligations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "model-weights"
          }
        }
      },
      "then": {
        "required": ["model"]
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "dataset"
          }
        }
      },
      "then": {
        "required": ["dataset"]
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "generated-adapter"
          }
        }
      },
      "then": {
        "required": ["generated_adapter"]
      }
    }
  ]
}
