# Local-only PostgreSQL settings for Phase 0.
# Copy to .env if you want to run docker compose directly instead of through Make.
POSTGRES_DB=ml_platform_local
POSTGRES_USER=ml_platform_app
POSTGRES_PASSWORD=change-me-local-postgres-password
POSTGRES_PORT=5432

# Local-only Garage settings for Phase 0.
GARAGE_RPC_SECRET=1111111111111111111111111111111111111111111111111111111111111111
GARAGE_ADMIN_TOKEN=change-me-local-garage-admin-token
GARAGE_METRICS_TOKEN=change-me-local-garage-metrics-token
GARAGE_KEY_ID=GK111111111111111111111111
GARAGE_SECRET_KEY=2222222222222222222222222222222222222222222222222222222222222222
GARAGE_BUCKET=ml-platform-artifacts
GARAGE_S3_REGION=garage
GARAGE_S3_ENDPOINT=http://127.0.0.1:3900
GARAGE_S3_PORT=3900
GARAGE_ADMIN_PORT=3903
